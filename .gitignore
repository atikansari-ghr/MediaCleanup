# Real config contains private API keys and machine-specific paths — NEVER commit.
# Share MediaCleanup.example.toml instead.
MediaCleanup.toml

# Bundled tool binaries (users drop their own MKVToolNix/FileBot in here).
# The folder skeleton + README are committed; every binary stays ignored.
runtimes/*
!runtimes/README.md
!runtimes/mkvtoolnix/
runtimes/mkvtoolnix/*
!runtimes/mkvtoolnix/.gitkeep
!runtimes/FileBot/
runtimes/FileBot/*
!runtimes/FileBot/.gitkeep
runtime/

# Local working files
backup/
logs/
*.log
*.tmp
*.mkv.tmp

# Python
__pycache__/
*.pyc
*.pyo

# Editor / OS noise
.vscode/
.idea/
Thumbs.db
desktop.ini

# Claude Code local settings
.claude/
